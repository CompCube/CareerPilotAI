# Copia aquest fitxer a .env i emplena els valors reals.
# .env MAI es puja a Git (mira el .gitignore).

# Clau d'API de console.anthropic.com
ANTHROPIC_API_KEY=

# Model a fer servir. Canviar aqui, mai al codi.
MODEL_NAME=claude-haiku-4-5-20251001

# Tokens maxims de sortida per defecte
MAX_TOKENS_DEFAULT=1024

# Dominis que poden cridar aquesta API, separats per comes.
# En local, deixa el de Vite. En produccio, afegeix la URL de Vercel.
ALLOWED_ORIGINS=http://localhost:5173

# Rate limit per IP
RATE_LIMIT_PER_MINUTE=10

# Mida maxima de fitxers pujats (MB)
MAX_UPLOAD_SIZE_MB=5

# --- Auth (login amb Google) ---

# Connexio a Postgres. Railway la injecta sola si tens el plugin de
# Postgres al mateix projecte. En local, deixa-ho buit -- cau a SQLite.
DATABASE_URL=

# Secret per signar els nostres propis JWT -- genera'n un de nou i unic,
# per exemple amb: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Dies de vida d'una sessio abans de necessitar tornar a fer login
JWT_EXPIRY_DAYS=7

# Client ID de Google OAuth (console.cloud.google.com -> Credentials).
# El mateix valor que VITE_GOOGLE_CLIENT_ID al frontend.
GOOGLE_CLIENT_ID=
