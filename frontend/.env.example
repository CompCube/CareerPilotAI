# Copia a .env.local per desenvolupament local.
# En producció (Vercel), configura aquesta variable al panell del projecte
# amb la URL real del backend desplegat (Railway/Render).

VITE_API_BASE_URL=http://localhost:8000

# Client ID de Google OAuth (console.cloud.google.com -> Credentials).
# NO es secret -- es un identificador public, segur de posar aqui.
VITE_GOOGLE_CLIENT_ID=
